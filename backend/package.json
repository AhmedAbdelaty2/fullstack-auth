{
  "name": "apex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "argon2": true,
    "@scarf/scarf": false
  },
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "nodemon": { "minimatch": "^11.0.1" }
  },
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts --delay 200ms --exec \"npm run build && npm start\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/auth.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^12.0.2",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/throttler": "^6.8.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.95.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.0"
  }
}
